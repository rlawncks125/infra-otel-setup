# Host ports. Change only when a default port conflicts with another service.
LOKI_PORT=3100
JAEGER_UI_PORT=16686
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_PROMETHEUS_EXPORTER_PORT=9464
PROMETHEUS_PORT=9090

          "editorMode": "code",
          "expr": "max by (service_name, app_route) (max_over_time({service_name=~\"$service\"} | json | app_route=~\"$route\" | http_server_duration_ms!=\"\" | unwrap http_server_duration_ms | __error__=\"\" [15s]))",

          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le, service_name, span_name) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=~\"$service\",span_kind=\"SPAN_KIND_SERVER\",span_name=~\".*($route)\"}[$__rate_interval])))",
          "legendFormat": "P50 · {{service_name}} · {{span_name}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.75, sum by (le, service_name, span_name) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=~\"$service\",span_kind=\"SPAN_KIND_SERVER\",span_name=~\".*($route)\"}[$__rate_interval])))",
          "legendFormat": "P75 · {{service_name}} · {{span_name}}",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, service_name, span_name) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=~\"$service\",span_kind=\"SPAN_KIND_SERVER\",span_name=~\".*($route)\"}[$__rate_interval])))",
          "legendFormat": "P95 · {{service_name}} · {{span_name}}",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Jaeger 기준 엔드포인트 지연시간 P50 / P75 / P95",
